<div class="home-container">
  <div>
    <h1 class="app-title">Playthroughs</h1>
    <%= link_to "START BUILDING YOUR TEAM", new_playthrough_path, class: "start-button" %>
  </div>
  <% if @playthroughs.any? %>
    <h2 class="section-title">Your Adventures<%= image_tag "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/poke-ball.png", class: "pokeball-img" %></h2>
    <div class="adventures-grid">
      <% @playthroughs.each do |playthrough| %>
        <div class="playthrough-card">
          <%= link_to playthrough_teams_path(playthrough) do %>
            <%= image_tag playthrough.game_version, class: "game-image" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
